# 1. Copy this file and name the copy exactly:  .env   (same folder as app.py)
# 2. Replace the placeholder after the = sign with your real key.
# No quotes, no spaces around the = sign.
GEMINI_API_KEY=PASTE_YOUR_KEY_HERE

# Optional: only change this if the default model stops working.
# GEMINI_MODEL=gemini-3.1-flash-lite
